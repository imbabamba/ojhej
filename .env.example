# ojhej.se local configuration
#
#   cp .env.example .env
#
# .env is gitignored. Never commit real values.
#
# You do NOT need any of this to run the service locally: `deno task dev` mints throwaway
# keys and writes mail to .devmail/ instead of sending it. Fill this in only when you want
# to test against real SMTP2GO.


# ---------------------------------------------------------------------------
# Mail transport
# ---------------------------------------------------------------------------
# capture  write mail to .devmail/ and print the link (default, no account needed)
# send     really send through SMTP2GO. Requires everything below to be filled in.
#
# Deliberately opt-in: a stray .env should never silently turn a local experiment into
# mail arriving in someone's actual inbox.
OJHEJ_MAIL=capture


# ---------------------------------------------------------------------------
# SMTP2GO
# ---------------------------------------------------------------------------
# Dashboard, Sending, API Keys. The key needs the "send email" permission.
OJHEJ_SMTP2GO_KEY=api-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The sending domain must be verified in SMTP2GO (SPF and DKIM) or mail will be rejected
# or land in spam. Until ojhej.se is verified, use an address on a domain you have already
# verified there, otherwise sends fail with succeeded=0.
OJHEJ_SENDER=Oj hej <hej@ojhej.se>

# EU accounts may use a different hostname. Confirm in the dashboard before trusting this
# default, and check the footer says "Hosted in the EU". See plan.md task 7.6.
OJHEJ_SMTP2GO_URL=https://api.smtp2go.com/v3


# ---------------------------------------------------------------------------
# Service
# ---------------------------------------------------------------------------
# Absolute, no trailing slash. Every verification and management link in outgoing mail is
# built from this, so with real sending it must be an address the recipient can actually
# reach. localhost is fine when you are clicking the links yourself.
OJHEJ_BASE_URL=http://localhost:8787

# Generate both with:  deno task keygen
#
# AES-256 key, base64, protects the owner address at rest. Changing it makes every stored
# address unreadable, so treat a rotation as a migration rather than a config change.
OJHEJ_EMAIL_KEY=

# Signs ALTCHA proof-of-work challenges. At least 16 characters. If this is missing or weak
# nothing crashes, which is precisely the danger: verification keeps working against a
# secret anyone can guess. loadConfig refuses to start rather than let that happen.
OJHEJ_ALTCHA_HMAC=

# Our own code, for the small QR in the footer. Optional: without it there is simply no QR.
#
# It is a real ojhej code that we own, so reaching us goes through the same form, the same
# relay and the same daily cap as reaching anyone else. Create one the normal way, verify it,
# and paste the code here.
#
# A malformed value is ignored rather than rendered, but a well-formed code that does not exist
# gives a broken image on every page, so check it loads once after setting it.
OJHEJ_KONTAKT_KOD=
