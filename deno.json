{
  "tasks": {
    "test": "deno test --allow-read",
    "test:watch": "deno test --watch --allow-read",
    "check": "deno check src/ edge/ scripts/",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "verify": "deno fmt --check && deno lint && deno check src/ edge/ scripts/ && deno test --allow-read",
    "print-pack": "deno run --allow-read --allow-write --allow-env scripts/print-pack.ts",
    "dev": "deno run --allow-net --allow-read --allow-write --allow-env src/main.ts --dev",
    "flow": "deno run --allow-net --allow-read --allow-env scripts/dev-flow.ts",
    "keygen": "deno run scripts/keygen.ts",
    "change-flow": "deno run --allow-net --allow-read --allow-env scripts/change-flow.ts",
    "koder-flow": "deno run --allow-net --allow-read --allow-env scripts/koder-flow.ts",
    "fonts": "deno run --allow-net --allow-read --allow-write scripts/fonts.ts",
    "asset-version": "deno run --allow-read --allow-write scripts/asset-version.ts",
    "bundle": "deno bundle --platform=browser -o dist/edge.js edge/main.ts",
    "upload-assets": "deno run --allow-read --allow-env --allow-net scripts/upload-assets.ts",
    "mark": "deno run --allow-read --allow-write scripts/mark-png.ts",
    "smoke": "deno run --allow-net --allow-env scripts/smoke.ts",
    "storage-probe": "deno run --allow-net --allow-env scripts/storage-probe.ts",
    "publish": "deno run --allow-read --allow-write --allow-run=git scripts/publish.ts"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.10",
    "@std/encoding": "jsr:@std/encoding@^1.0.6",
    "@std/testing": "jsr:@std/testing@^1.0.8",
    "@bunny.net/edgescript-sdk": "npm:@bunny.net/edgescript-sdk@0.12.1"
  },
  "nodeModulesDir": "auto",
  "name": "ojhej",
  "version": "0.1.0",
  "exports": "./src/main.ts",
  "fmt": {
    "lineWidth": 100,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": false,
    "include": [
      "src/",
      "scripts/",
      "edge/"
    ],
    "exclude": [
      "mockups/",
      "dist/",
      "node_modules/",
      "specs/",
      "public/"
    ]
  },
  "lint": {
    "exclude": [
      "mockups/",
      "dist/",
      "node_modules/",
      "public/"
    ],
    "rules": {
      "tags": [
        "recommended"
      ],
      "include": [
        "no-console",
        "eqeqeq",
        "no-throw-literal"
      ]
    }
  },
  "exclude": [
    "node_modules/",
    "dist/"
  ],
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true
  }
}
